rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA — Painel do Polo
// Cole este conteúdo em: Firebase Console > Firestore Database
// > Regras (aba "Rules") > substitua tudo > Publicar
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada usuário (usado para localizar colegas por e-mail)
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /polos/{poloId} {
      // Só quem está na lista de gestores do polo pode ler/atualizar
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.gestores;

      // Qualquer usuário logado pode criar um polo, desde que já se
      // inclua na lista de gestores no momento da criação
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.gestores;

      allow delete: if false;

      // Leads e eventos só são acessíveis por quem gerencia o polo pai
      match /leads/{leadId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
      }

      match /eventos/{eventoId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
      }

      // Financeiro do polo
      match /financeiro/{txId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
      }

      // Cronômetro de tarefas (registro de tempo por atividade)
      match /cronometro/{registroId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
      }

      // Plano de ações anual
      match /planoAcoes/{acaoId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
      }

      // Relatórios mensais e as ações registradas em cada um
      match /relatorios/{relatorioId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;

        match /acoes/{acaoId} {
          allow read, write: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
        }
      }
    }
  }
}
