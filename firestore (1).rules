rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA — PoloSync (com administrador + assinaturas)
// Cole em: Firebase Console > Firestore Database > Regras
// > substitua tudo > Publicar
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    // Administrador = existe um documento admins/{uid} (criado só pelo Console)
    function isAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Assinatura ativa e dentro do prazo
    function assinaturaAtiva() {
      let ref = /databases/$(database)/documents/assinaturas/$(request.auth.uid);
      return logado() && exists(ref)
        && get(ref).data.ativo == true
        && (!('expiraEm' in get(ref).data)
            || get(ref).data.expiraEm == null
            || get(ref).data.expiraEm > request.time);
    }

    function gestorDoPolo(poloId) {
      return request.auth.uid in get(/databases/$(database)/documents/polos/$(poloId)).data.gestores;
    }

    function podeAcessarPolo(poloId) {
      return isAdmin() || (assinaturaAtiva() && gestorDoPolo(poloId));
    }

    // ---------- Administração ----------
    // Cada um só lê o próprio documento de admin; ninguém escreve pelo app
    match /admins/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Assinatura: o gestor lê a própria; só o admin cria/edita
    match /assinaturas/{uid} {
      allow get: if logado() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Configurações gerais (WhatsApp de contato, mensagem de bloqueio)
    match /config/{docId} {
      allow read: if logado();
      allow write: if isAdmin();
    }

    // ---------- Usuários ----------
    match /usuarios/{uid} {
      allow get: if logado();
      allow list: if isAdmin();
      allow create, update: if logado() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Índice e-mail -> uid (para adicionar colegas ao polo)
    match /emailIndex/{email} {
      allow get: if logado();
      allow list: if false;
      allow create, update: if logado() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- Polos e tudo dentro deles ----------
    match /polos/{poloId} {
      allow read, update: if isAdmin()
        || (assinaturaAtiva() && request.auth.uid in resource.data.gestores);

      allow create: if isAdmin()
        || (assinaturaAtiva() && request.auth.uid in request.resource.data.gestores);

      allow delete: if false;

      // leads (+timeline), eventos, metas, relatorios (+acoes),
      // planoAcoes, financeiro, cronometro
      match /{sub=**} {
        allow read, write: if podeAcessarPolo(poloId);
      }
    }
  }
}
